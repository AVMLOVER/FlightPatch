/* /uiaccess - let osk.exe, Narrator.exe and Magnify.exe start on a build whose
   Microsoft signature is no longer valid.

   These three programs declare uiAccess="true" in their manifest. The loader only
   grants the uiAccess token to an image whose signature validates against a
   publisher it accepts, and on an expired preview build that check fails, so
   CreateProcess reports ERROR_ELEVATION_REQUIRED (740) and the program never
   starts. A locally trusted signature does not satisfy it either, which was
   measured. Removing the declaration drops that requirement: the programs start
   normally, with the single consequence that they can no longer drive windows of
   elevated processes.

   The attribute is blanked in place with spaces, so the resource keeps its size
   and only the XML text changes:
       <requestedExecutionLevel level="asInvoker" uiAccess="true"/>
       <requestedExecutionLevel level="asInvoker"                />
   The program is then signed with the package certificate and that certificate is
   trusted in the offline stores, because a rewritten manifest invalidates the
   vendor signature and the loader would otherwise refuse the image. */

static const struct {
    const wchar_t *relative;
    const wchar_t *leaf;
    const wchar_t *name;
} uiaccess_targets[] = {
    {L"System32\\osk.exe", L"osk.exe", L"osk"},
    {L"System32\\Narrator.exe", L"Narrator.exe", L"Narrator"},
    {L"System32\\Magnify.exe", L"Magnify.exe", L"Magnify"},
    {L"SysWOW64\\osk.exe", L"osk.exe", L"osk (32-bit)"},
    {L"SysWOW64\\Narrator.exe", L"Narrator.exe", L"Narrator (32-bit)"},
    {L"SysWOW64\\Magnify.exe", L"Magnify.exe", L"Magnify (32-bit)"}
};

static BOOL plan_uiaccess(const Image *im, Plan *plan)
{
    static const char attribute[] = "uiAccess=\"true\"";
    DWORD found = NONE;
    unsigned matches = 0;
    for (DWORD o = 0; o + sizeof attribute - 1 <= im->size; ++o) {
        if (memcmp(im->bytes + o, attribute, sizeof attribute - 1))
            continue;
        if (++matches > 1) {
            fwprintf(stderr, L"  More than one uiAccess declaration; nothing was changed.\n");
            return FALSE;
        }
        found = o;
    }
    if (found == NONE)
        return FALSE;
    /* Blank the declaration and the whitespace that separated it, so the start
       tag keeps its length and only loses an attribute. */
    DWORD start = found;
    while (start > 0) {
        BYTE previous = im->bytes[start - 1];
        if (previous != ' ' && previous != '\t' && previous != '\r' && previous != '\n')
            break;
        --start;
    }
    DWORD length = found + (DWORD)(sizeof attribute - 1) - start;
    BYTE *blank = malloc(length);
    if (!blank)
        return FALSE;
    memset(blank, ' ', length);
    BOOL ok = record(im, plan, start, (const char *)blank, length, L"uiAccess requirement removed");
    free(blank);
    return ok;
}

static BOOL uiaccess_offline(BCRYPT_ALG_HANDLE algorithm, const wchar_t *argument, BOOL restore)
{
    wchar_t path[PATH_SIZE], parent[PATH_SIZE], base[PATH_SIZE];
    InputKind input;
    PatchScope scope;
    if (!normalize(path, argument) || !patch_input_kind(path, &input)) {
        fwprintf(stderr, L"Specify the offline Windows root, the extracted folder, or one file.\n");
        return FALSE;
    }
    if (wintrust_running(path)) {
        fwprintf(stderr, L"%ls is the running installation. Use /uiaccess from WinPE or another\n"
                         L"Windows installation against that volume; the programs are in use here.\n", path);
        return FALSE;
    }
    base[0] = L'\0';
    if (input == INPUT_FILE) {
        if (!patch_parent_directory(path, parent) || !patch_scope_init(&scope, parent))
            return FALSE;
    } else {
        if (!patch_scope_init(&scope, path))
            return FALSE;
        wcsncpy(base, path, PATH_SIZE - 1);
        base[PATH_SIZE - 1] = L'\0';
    }

    if (restore) {
        RestoreCount count = {0};
        NttpCertificate certificate = {0};
        BOOL ok = TRUE;
        if (input == INPUT_FILE) {
            ok = restore_one(algorithm, &scope, path, &count);
        } else {
            BOOL flat = input == INPUT_FLAT;
            for (unsigned i = 0; ok && i < ARRAYSIZE(uiaccess_targets); ++i) {
                if (flat && i >= 3)
                    break;
                wchar_t candidate[PATH_SIZE];
                const wchar_t *relative = flat ? uiaccess_targets[i].leaf : uiaccess_targets[i].relative;
                if (!build_path(candidate, base, relative) ||
                    GetFileAttributesW(candidate) == INVALID_FILE_ATTRIBUTES)
                    continue;
                ok = restore_one(algorithm, &scope, candidate, &count);
            }
        }
        if (ok && input == INPUT_ROOT)
            ok = wintrust_offline_trust(base, &certificate, FALSE);
        if (count.restored)
            wprintf(L"%u program(s) restored in %ls.\n", count.restored,
                    input == INPUT_FILE ? patch_leaf(path) : base);
        else
            wprintf(L"No retained original was found for these programs.\n");
        return ok && count.failed == 0;
    }

    PatchSpec specs[ARRAYSIZE(uiaccess_targets)];
    unsigned char states[ARRAYSIZE(uiaccess_targets)] = {0};
    unsigned count = 0;
    if (input == INPUT_FILE) {
        specs[count++] = (PatchSpec){.relative = path, .name = patch_leaf(path), .required = TRUE,
                                     .skip_unsupported = FALSE, .plan = plan_uiaccess,
                                     .build = wintrust_build, .recognized = wintrust_recognized};
    } else {
        BOOL flat = input == INPUT_FLAT;
        for (unsigned i = 0; i < ARRAYSIZE(uiaccess_targets); ++i) {
            if (flat && i >= 3)
                break;
            specs[count++] = (PatchSpec){
                .relative = flat ? uiaccess_targets[i].leaf : uiaccess_targets[i].relative,
                .name = uiaccess_targets[i].name,
                .required = FALSE,
                .skip_unsupported = TRUE,
                .plan = plan_uiaccess,
                .build = wintrust_build,
                .recognized = wintrust_recognized
            };
        }
    }

    WintrustSigner signer = {0};
    if (!signer_open(&signer.signer, WINTRUST_SUBJECT))
        return FALSE;
    BOOL ok = patch_specs(algorithm, &scope, input == INPUT_FILE ? NULL : base, specs, count, states,
                          wintrust_offline_post, &signer);
    if (ok && !signer.signed_something) {
        for (unsigned i = 0; i < count && !signer.signed_something; ++i) {
            wchar_t candidate[PATH_SIZE];
            if (!build_path(candidate, base, specs[i].relative))
                continue;
            if (signer_extract(candidate, WINTRUST_SUBJECT_NAME, &signer.certificate))
                signer.signed_something = TRUE;
        }
        if (!signer.signed_something && input == INPUT_FILE &&
            signer_extract(path, WINTRUST_SUBJECT_NAME, &signer.certificate))
            signer.signed_something = TRUE;
    }
    if (ok && signer.signed_something && input == INPUT_ROOT)
        ok = wintrust_offline_trust(base, &signer.certificate, TRUE);
    else if (ok && signer.signed_something)
        wprintf(L"The offline SOFTWARE hive was not touched: install trust from the offline Windows\n"
                L"root, not from a flat folder or a single file.\n");
    signer_close(&signer.signer);
    if (ok)
        wprintf(L"These programs no longer require the uiAccess token, so they start without the\n"
                L"publisher check that fails on an expired build. They cannot drive elevated windows.\n");
    return ok;
}

static int run_uiaccess(BCRYPT_ALG_HANDLE algorithm, int argc, wchar_t **argv)
{
    BOOL restore = !_wcsicmp(argv[1], L"/uiaccess-restore");
    if (argc != 3) {
        fwprintf(stderr, L"Usage: nttimebomb %ls OFFLINE_ROOT|FOLDER|FILE\n", argv[1]);
        return 2;
    }
    if ((in_winpe() && !is_system()) || !enable_privilege(L"SeBackupPrivilege") ||
        !enable_privilege(L"SeRestorePrivilege")) {
        privilege_hint();
        return 3;
    }
    BOOL ok = uiaccess_offline(algorithm, argv[2], restore);
    return ok ? 0 : 1;
}
